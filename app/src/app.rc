#pragma code_page(65001)
#include <winver.h>

LANGUAGE 9, 1

1 ICON "app.ico"

// 应用清单（RT_MANIFEST = 24）：声明支持 Win11，系统菜单才会用圆角新样式
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS 0x40004L
FILETYPE 0x1L
{
    BLOCK "StringFileInfo"
    {
        BLOCK "080404b0"
        {
            VALUE "CompanyName", "Personal"
            VALUE "FileDescription", "余电 - 外设电量托盘工具"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "ProductName", "余电"
            VALUE "ProductVersion", "1.0.0.0"
            VALUE "OriginalFilename", "yudian.exe"
        }
    }
    BLOCK "VarFileInfo"
    {
        VALUE "Translation", 0x804, 1200
    }
}
